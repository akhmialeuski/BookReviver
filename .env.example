# Copy to .env and fill in. Nested settings use a double underscore.
# Signs verification and reset tokens and the CSRF cookie. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOOKREVIVER_AUTH__SECRET=
# Local development serves plain HTTP, so session cookies must not require HTTPS
BOOKREVIVER_AUTH__COOKIE_SECURE=false
# Address the application is reached at from outside; mail links and the provider redirect URI are built from it
BOOKREVIVER_PUBLIC_URL=http://127.0.0.1:8000
# Optional: social sign-in, enabled when both values are set; the redirect URI to register is {public_url}/auth/{provider}/callback
BOOKREVIVER_AUTH__GOOGLE__CLIENT_ID=
BOOKREVIVER_AUTH__GOOGLE__CLIENT_SECRET=
BOOKREVIVER_AUTH__FACEBOOK__CLIENT_ID=
BOOKREVIVER_AUTH__FACEBOOK__CLIENT_SECRET=
# Optional: SMTP for verification and reset mail; without a host, mail is written to the server log.
# Set the host only together with the password, since a host without one makes the server refuse the message
BOOKREVIVER_MAIL__SMTP_HOST=
BOOKREVIVER_MAIL__SMTP_PORT=587
BOOKREVIVER_MAIL__SMTP_USERNAME=
BOOKREVIVER_MAIL__SMTP_PASSWORD=
# BOOKREVIVER_MAIL__SENDER=you@example.org
