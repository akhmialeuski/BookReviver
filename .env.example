# Copy to .env and fill in. Nested settings use a double underscore.
# Signs verification and reset tokens and the CSRF cookie. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOOKREVIVER_AUTH__SECRET=
# Local development serves plain HTTP, so session cookies must not require HTTPS
BOOKREVIVER_AUTH__COOKIE_SECURE=false
# Optional: social sign-in, enabled when both values are set
BOOKREVIVER_AUTH__GOOGLE__CLIENT_ID=
BOOKREVIVER_AUTH__GOOGLE__CLIENT_SECRET=
BOOKREVIVER_AUTH__FACEBOOK__CLIENT_ID=
BOOKREVIVER_AUTH__FACEBOOK__CLIENT_SECRET=
BOOKREVIVER_AUTH__X__CLIENT_ID=
BOOKREVIVER_AUTH__X__CLIENT_SECRET=
# Optional: SMTP for verification and reset mail; without it, mail is written to the log
BOOKREVIVER_MAIL__SMTP_HOST=
