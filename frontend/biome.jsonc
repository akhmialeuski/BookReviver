{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "includes": [
      "**",
      // Generated by @hey-api/openapi-ts from docs/openapi.json and never edited by hand, so it follows the
      // generator's style, not ours
      "!src/api",
      // Generated by the TanStack Router plugin from the files of src/routes
      "!src/routeTree.gen.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "css": { "parser": { "tailwindDirectives": true } },
  // The pretty-format-json hook of the repository formats every .json file, and the two layouts differ
  "json": { "formatter": { "enabled": false } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error", "noTsIgnore": "error" },
      "style": { "useImportType": "error", "noNonNullAssertion": "error" }
    }
  }
}
